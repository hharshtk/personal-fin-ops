{
  "name": "myfinancespace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @myfinancespace/web",
    "build": "npm run build -w @myfinancespace/web",
    "start": "npm run start -w @myfinancespace/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "mobile": "npm run start -w @myfinancespace/mobile --",
    "android": "npm run android -w @myfinancespace/mobile --",
    "ios": "npm run ios -w @myfinancespace/mobile --",
    "mobile:native": "npm run native -w @myfinancespace/mobile --"
  }
}
