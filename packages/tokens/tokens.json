{
  "note": "Source of every design token (CONSTITUTION.md, Article 10). Sizes are px on the web, pt on iOS and dp on Android. After editing, run: npm run tokens",
  "color": {
    "paper": { "light": "#ffffff", "dark": "#15171e", "note": "Surface that content is printed on." },
    "paper-2": { "light": "#f6f7f9", "dark": "#1b1e27" },
    "paper-3": { "light": "#eceef2", "dark": "#252935" },
    "ground": { "light": "#f1f2f5", "dark": "#101218", "note": "Canvas behind paper." },
    "ink": { "light": "#191b22", "dark": "#e8eaf0", "note": "Printed facts. ink-2 and ink-3 are quieter." },
    "ink-2": { "light": "#4b5060", "dark": "#b0b5c3" },
    "ink-3": { "light": "#676c7c", "dark": "#8d93a4" },
    "rule": { "light": "#e4e6eb", "dark": "#2a2e3a", "note": "Hairlines. rule-2 is stronger." },
    "rule-2": { "light": "#cdd1d9", "dark": "#3b4050" },
    "pen": { "light": "#2b3aa8", "dark": "#a3adff", "note": "The user's own hand: actions, selection, focus, manual entries." },
    "pen-2": { "light": "#3d4cc0", "dark": "#8f9bff" },
    "pen-wash": { "light": "#eef0fc", "dark": "#232a52" },
    "pen-wash-2": { "light": "#e0e4fa", "dark": "#2d3566" },
    "red": { "light": "#c2202e", "dark": "#ff7b80", "note": "Money due, overdue or lost. Nothing else." },
    "red-wash": { "light": "#fdeeef", "dark": "#3a1d23" },
    "green": { "light": "#17784a", "dark": "#55c78e", "note": "Money in and gains." },
    "green-wash": { "light": "#e9f5ee", "dark": "#15302a" },
    "amber": { "light": "#965500", "dark": "#f1b24c", "note": "A limit is close." },
    "amber-wash": { "light": "#fdf2df", "dark": "#33270f" },
    "rail": { "light": "#f6f7f9", "dark": "#101218", "note": "Web navigation rail." },
    "rail-ink": { "light": "#2b2f3a", "dark": "#d6d9e2" },
    "rail-ink-2": { "light": "#646a7a", "dark": "#8b91a1" },
    "rail-hover": { "light": "#eceef2", "dark": "#1b1e27" },
    "rail-rule": { "light": "#e4e6eb", "dark": "#23262f" },
    "c1": { "light": "#00927e", "dark": "#12a08b", "note": "Data series c1 to c6: validated categorical order. Do not reorder." },
    "c2": { "light": "#d97a1e", "dark": "#d57a2c" },
    "c3": { "light": "#1f86c7", "dark": "#2f93d0" },
    "c4": { "light": "#b98b00", "dark": "#b08812" },
    "c5": { "light": "#9a4fb5", "dark": "#ac6bc8" },
    "c6": { "light": "#4e8a2e", "dark": "#5e9e3c" },
    "c-neutral": { "light": "#9aa0ad", "dark": "#6b7183" },
    "c-track": { "light": "#eceef2", "dark": "#262a36" },
    "on-c1": { "light": "#0b0c10", "dark": "#0b0c10", "note": "Label printed inside a series fill." },
    "on-c2": { "light": "#0b0c10", "dark": "#0b0c10" },
    "on-c3": { "light": "#0b0c10", "dark": "#0b0c10" },
    "on-c4": { "light": "#0b0c10", "dark": "#0b0c10" },
    "on-c5": { "light": "#ffffff", "dark": "#0b0c10" },
    "on-c6": { "light": "#0b0c10", "dark": "#0b0c10" }
  },
  "type": {
    "2xs": { "size": 11, "lineHeight": 14 },
    "xs": { "size": 12, "lineHeight": 16 },
    "sm": { "size": 13, "lineHeight": 18 },
    "base": { "size": 14, "lineHeight": 20 },
    "lg": { "size": 16, "lineHeight": 22 },
    "xl": { "size": 20, "lineHeight": 26 },
    "2xl": { "size": 24, "lineHeight": 30 },
    "3xl": { "size": 32, "lineHeight": 36 }
  },
  "radius": { "xs": 2, "sm": 3, "md": 5, "lg": 8 },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32 },
  "touchTarget": { "ios": 44, "android": 48 }
}
