# Port for this app (personal finance). fin-ops uses 3000.
PORT=4000

# Server-only keys for voice input in Ask AI. Put the real values in
# .env.local, which git ignores, and in the Vercel project's environment.

# Vercel AI Gateway: the OpenAI and Google transcription models, and the
# credit balance in Settings.
AI_GATEWAY_API_KEY=

# Groq: the Whisper models, including the default. Without it, voice input
# falls back to the gateway models.
GROQ_API_KEY=
